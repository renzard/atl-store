# Versions of the ATL dependencies, used by tools/build_atl.sh (and so by CI).
# A value given in the environment wins over this file.
#
# "master" moves every day, so a build today and a build next month can differ (or one of them breaks).
# After a build that works, open usr/share/atl-build-info.txt: it lists the exact commit of every dependency.
# Paste those commits here (a tag, a branch or a full commit hash all work) to freeze the versions.
WOLFSSL_REF="${WOLFSSL_REF:-v5.8.2-stable}"
BIONIC_REF="${BIONIC_REF:-master}"
ART_REF="${ART_REF:-master}"
OPENSLES_REF="${OPENSLES_REF:-master}"
